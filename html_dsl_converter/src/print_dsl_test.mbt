///|
test "login_snippet" {
  let html =
    #|<html lang="en"><head><title>Sign in</title><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="stylesheet" href="/styles.css"></head><body><div class="min-h-screen flex items-center justify-center bg-gray-50"><div class="max-w-md w-full space-y-8 p-8 bg-white rounded-xl shadow"><h1>Sign in to your account</h1><form onsubmit="handleLogin(event)"><div class="space-y-4 my-4"><div class="flex gap-8"><label class="w-16" for="email">Email</label><input name="email" required type="email" placeholder="you@example.com"></div><div><label class="w-16" for="password">Password</label><input name="password" required type="password" placeholder="••••••••"></div></div><button class="w-full py-2 px-4 bg-blue-600 text-white rounded-lg" type="submit">Sign in</button></form><p class="text-center text-sm text-gray-500">Don&#39;t have an account? <a href="/register">Register</a></p></div></div></body></html>
  let code = convert_html(html)
  let expected =
    #|fragment([title("Sign in"), meta(attrs=[Attr::Prop("charset", "utf-8")]), meta(attrs=[Attr::Prop("name", "viewport"), Attr::Prop("content", "width=device-width, initial-scale=1")]), node("link", [Attr::Prop("rel", "stylesheet"), Attr::Prop("href", "/styles.css")], []), div(attrs=[Attr::Prop("class", "min-h-screen flex items-center justify-center bg-gray-50")], [div(attrs=[Attr::Prop("class", "max-w-md w-full space-y-8 p-8 bg-white rounded-xl shadow")], [h1([text("Sign in to your account")]), form(attrs=[Attr::Prop("onsubmit", "handleLogin(event)")], [div(attrs=[Attr::Prop("class", "space-y-4 my-4")], [div(attrs=[Attr::Prop("class", "flex gap-8")], [label(attrs=[Attr::Prop("class", "w-16"), Attr::Prop("for", "email")], [text("Email")]), input(required=true, attrs=[Attr::Prop("name", "email"), Attr::Prop("type", "email"), Attr::Prop("placeholder", "you@example.com")])]), div([label(attrs=[Attr::Prop("class", "w-16"), Attr::Prop("for", "password")], [text("Password")]), input(required=true, attrs=[Attr::Prop("name", "password"), Attr::Prop("type", "password"), Attr::Prop("placeholder", "••••••••")])])]), button(attrs=[Attr::Prop("class", "w-full py-2 px-4 bg-blue-600 text-white rounded-lg"), Attr::Prop("type", "submit")], [text("Sign in")])]), p(attrs=[Attr::Prop("class", "text-center text-sm text-gray-500")], [text("Don't have an account? "), a(attrs=[Attr::Prop("href", "/register")], [text("Register")])])])])])
  assert_eq(code, expected)
}
